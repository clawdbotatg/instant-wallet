{
  "manifest_version": 3,
  "name": "Instant Wallet",
  "version": "0.1.0",
  "description": "Use your Instant Wallet on any site. The site asks, you approve in Instant Wallet. No keys in the extension.",
  "homepage_url": "https://instantwallet.io",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Instant Wallet",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://instantwallet.io/*", "https://instant-wallet-b2jn.vercel.app/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://instantwallet.io/*", "https://instant-wallet-b2jn.vercel.app/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://instantwallet.io/*", "https://instant-wallet-b2jn.vercel.app/*"],
      "js": ["site.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://instantwallet.io/*", "https://instant-wallet-b2jn.vercel.app/*"],
      "js": ["wallet.js"],
      "run_at": "document_start"
    }
  ]
}
