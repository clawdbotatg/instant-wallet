# Copy to .env.local. Everything is optional except the facilitator key.

# Chain: localhost (anvil 31337 at http://127.0.0.1:8545), baseSepolia (84532) or base (8453), both via Alchemy
NEXT_PUBLIC_TARGET_NETWORK=localhost
NEXT_PUBLIC_ALCHEMY_API_KEY=
# LOCAL_RPC_URL=http://127.0.0.1:8545
# RPC_URL=                         # override the Base RPC
# MAINNET_RPC_URL=                 # ENS resolution (defaults to Alchemy mainnet with the key above, else cloudflare-eth)

# The facilitator: relays signed meta calls and pays gas. Locally = anvil account 0.
FACILITATOR_PRIVATE_KEY=0x...
# FACILITATOR_FEE=20000            # token base units charged inside every transfer (default 0.02 USDC)

# Contract addresses come from contracts/deployedContracts.ts; override on chains without an entry:
# NEXT_PUBLIC_FACTORY_ADDRESS=0x...
# NEXT_PUBLIC_TOKEN_ADDRESS=0x...   # defaults to MockUSDC locally, USDC on Base

# Device queue store: Upstash Redis (REST) on serverless hosts, keys under iw:<chainId>:*; JSON file in .instant/ otherwise
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REQUEST_TTL_SECONDS=600
# INSTANT_STORE_PATH=.instant/store.json

# Optional integrations (features degrade gracefully without them)
ZERION_API_KEY=                    # portfolio/activity/prices on Base
ANTHROPIC_API_KEY=                 # "Claude (this app's key)" provider for talk-to-your-wallet
# ANTHROPIC_MODEL=claude-sonnet-5
